# Every variable the services read. Copy to .env for local runs; never commit real values.
# Production values are set in each AppSail service's environment variables.
APP_ENV=local                       # local | production (changes log format only)
SERVICE_NAME=api                    # api | worker (set per service)

# Supabase Postgres through the pooler (never the direct IPv6 host)
DATABASE_URL_POOLED=postgresql://app_api.<ref>:<password>@<pooler-host>:6543/postgres   # api, transaction mode
DATABASE_URL_SESSION=postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres # worker + migrations, session mode
DB_POOL_MIN=1
DB_POOL_MAX=5
APP_API_PASSWORD=change-me          # used once by scripts/migrate.py to enable the app_api login

# Supabase Storage + Auth
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>      # server side only; never sent to the browser
SUPABASE_ANON_KEY=<anon-or-publishable-key>         # only for scripts/get_token.py (sign-in for tests)
SUPABASE_JWT_SECRET=<legacy-jwt-secret>           # api: only if the project signs tokens with the legacy HS256 secret
STORAGE_BUCKET=fmcg-data                          # private bucket; workspaces/, runs/, uploads/ prefixes

# OpenRouter
OPENROUTER_API_KEY=<key>
LLM_MODEL=<provider/model-id>                     # open decision: pinned model id with JSON-schema output
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Jobs, errors, worker
JOB_TOKEN=<random-32+-chars>                      # X-Job-Token for /jobs/sweep and /jobs/runs/baseline
SENTRY_DSN=                                       # optional locally
WORKER_ID=worker-1                                # defaults to hostname-pid
TMP_DIR=/tmp/fmcg
DUCKDB_MEMORY_LIMIT=1GB                           # below the AppSail memory setting
CORS_ORIGINS=http://localhost:5173                # comma-separated; no wildcard in production
GIT_SHA=dev                                       # set by CI on deploy; pins workflow_version

# Set by Catalyst in production; set by hand only locally (8000 api, 8001 worker)
X_ZOHO_CATALYST_LISTEN_PORT=8000

# AppSail wake-up: public URLs of the services (set after the first deploy)
WORKER_URL=                                       # api + worker: https://<worker-appsail-url>
